# Copiar para .env.local. Inventário completo em docs/specs/02-security-rls.md (SEC-003).
# Valores locais vêm de `supabase status`. Nunca commitar valores reais.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no server do apps/web (SEC-002).
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RIO_NEGRO_URL=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Segredo do HMAC de IP e e-mail (SEC-004). Mínimo de 32 caracteres.
LEAD_HASH_SECRET=

# Opcionais: webhook do CRM. Com a URL (https), o segredo é obrigatório e tem no mínimo 32 caracteres.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
