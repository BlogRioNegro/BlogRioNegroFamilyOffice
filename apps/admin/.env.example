# Copiar para .env.local. Inventário completo em docs/specs/02-security-rls.md (SEC-003).
# Valores locais vêm de `supabase status`. Nunca commitar valores reais.
# Sem SUPABASE_SERVICE_ROLE_KEY: o admin opera com a sessão sob RLS (SEC-002).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001

# Opcionais: webhook do CRM. Com a URL (https), o segredo é obrigatório e tem no mínimo 32 caracteres.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
