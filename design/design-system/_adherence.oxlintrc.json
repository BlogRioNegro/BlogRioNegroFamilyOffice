{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/admin/**",
              "ui_kits/blog/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Inter, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|className|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, title, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:success|error|warning)$/]",
        "message": "<Alert> variant must be one of 'success' | 'error' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|title|date|type|cover|coverAlt|loading|className|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: href, title, date, type, cover, coverAlt, loading, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:pdf|text)$/]",
        "message": "<ArticleCard> type must be one of 'pdf' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|disabled|block|iconLeft|iconRight|iconOnly|label|href|type|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, disabled, block, iconLeft, iconRight, iconOnly, label, href, type, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|checked|defaultChecked|onChange|disabled|error|className|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: id, checked, defaultChecked, onChange, disabled, error, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|width|align|muted|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, width, align, muted, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeaturedArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|title|excerpt|date|type|cover|coverAlt|loading|className|key|ref|className|style|children)$/]",
        "message": "<FeaturedArticleCard> doesn't accept that prop. Declared props: href, title, excerpt, date, type, cover, coverAlt, loading, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeaturedArticleCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:pdf|text)$/]",
        "message": "<FeaturedArticleCard> type must be one of 'pdf' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|variant|children|key|ref|className|style|children)$/]",
        "message": "<FieldMessage> doesn't accept that prop. Declared props: id, variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldMessage'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:help|error)$/]",
        "message": "<FieldMessage> variant must be one of 'help' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|optional|id|type|value|defaultValue|placeholder|disabled|onChange|className|inputClassName|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, help, error, optional, id, type, value, defaultValue, placeholder, disabled, onChange, className, inputClassName."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:htmlFor|optional|className|children|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: htmlFor, optional, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadMoreButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:loading|done|error|onClick|doneText|key|ref|className|style|children)$/]",
        "message": "<LoadMoreButton> doesn't accept that prop. Declared props: loading, done, error, onClick, doneText."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|footer|inline|mobile|className|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, children, footer, inline, mobile, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|totalPages|total|pageSize|onChange|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, totalPages, total, pageSize, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|help|error|disabled|key|ref|className|style|children)$/]",
        "message": "<PhoneInput> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, help, error, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|ctaHref|privacyHref|legal|year|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: logoSrc, ctaHref, privacyHref, legal, year."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|homeHref|links|current|right|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: logoSrc, homeHref, links, current, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:disabled|pending|sent|failed)$/]",
        "message": "<StatusBadge> status must be one of 'disabled' | 'pending' | 'sent' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypeBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|key|ref|className|style|children)$/]",
        "message": "<TypeBadge> doesn't accept that prop. Declared props: type."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypeBadge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:pdf|text)$/]",
        "message": "<TypeBadge> type must be one of 'pdf' | 'text'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
